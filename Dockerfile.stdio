# Local / Glama stdio image — not used by Apify (see ./Dockerfile).
FROM node:20-bookworm-slim
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev --omit=optional --audit=false --fund=false
COPY dist ./dist
# Default: MCP over stdio (what Glama introspection expects)
CMD ["node", "dist/index.js"]
