{
  "name": "app-review-intel-mcp",
  "version": "1.1.2",
  "description": "MCP server for App Store and Google Play reviews: search apps, fetch reviews, surface top complaints and what got worse in the latest version, and compare competitors. No API keys.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "app-review-intel-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "test": "npm run build && node test/itunes-empty.mjs && node test/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "app-store",
    "google-play",
    "play-store",
    "ios",
    "android",
    "app-reviews",
    "review-analysis",
    "app-store-reviews",
    "google-play-reviews",
    "competitor-analysis",
    "aso",
    "user-feedback",
    "claude",
    "ai-agents"
  ],
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "apify": "^3.7.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
